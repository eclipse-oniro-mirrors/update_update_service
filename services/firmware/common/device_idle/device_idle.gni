import("//base/update/updateservice/updateengine.gni")

device_idle_root_path = "$updateengine_root_path/services/firmware/common/device_idle"

device_idle_include = [ "$device_idle_root_path/include" ]
device_idle_src = [ "$device_idle_root_path/src/device_idle_utils.cpp" ]

if (defined(global_parts_info) &&
    defined(global_parts_info.powermgr_power_manager)) {
  device_idle_src += [ "$device_idle_root_path/src/screen_state_utils.cpp" ]
} else {
  device_idle_src += [ "$device_idle_root_path/src/screen_state_utils_fake.cpp" ]
}

if (defined(global_parts_info) &&
    defined(global_parts_info.telephony_call_manager)) {
  device_idle_src += [ "$device_idle_root_path/src/call_state_utils.cpp" ]
} else {
  device_idle_src += [ "$device_idle_root_path/src/call_state_utils_fake.cpp" ]
}

if (defined(global_parts_info) &&
    defined(global_parts_info.multimedia_audio_framework)) {
  device_idle_src += [ "$device_idle_root_path/src/music_state_utils.cpp" ]
} else {
  device_idle_src += [ "$device_idle_root_path/src/music_state_utils_fake.cpp" ]
}
